{
  "name": "gu-mcp",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "description": "基础 Node TypeScript MCP 服务。",
  "author": "nxy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nixwai/gu-mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "node"
  ],
  "bin": {
    "gu-mcp": "dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "pnpm run dev:stdio",
    "dev:stdio": "tsx src/entry/stdio.ts",
    "dev:http": "tsx src/entry/http.ts",
    "build": "tsdown",
    "start:stdio": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "mcp:inspect": "pnpm run build && pnpm dlx @modelcontextprotocol/inspector node dist/stdio.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
